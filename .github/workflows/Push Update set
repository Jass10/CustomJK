name: Push ServiceNow Update Set to Target

on:
  workflow_dispatch:
    inputs:
      update_set_folder:
        description: 'Folder name under servicenow/update-sets/ to deploy'
        required: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: servicenow-prod   # requires reviewers
    timeout-minutes: 30
    concurrency:
      group: servicenow-deploy-prod
      cancel-in-progress: false
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Get target access token
        env:
          TARGET_SNOW_INSTANCE: ${{ vars.TARGET_SNOW_INSTANCE }}
          TARGET_SNOW_CLIENT_ID: ${{ secrets.TARGET_SNOW_CLIENT_ID }}
          TARGET_SNOW_CLIENT_SECRET: ${{ secrets.TARGET_SNOW_CLIENT_SECRET }}
          TARGET_SNOW_USERNAME: ${{ secrets.TARGET_SNOW_USERNAME }}
          TARGET_SNOW_PASSWORD: ${{ secrets.TARGET_SNOW_PASSWORD }}
        run: |
          # Same token request as the pull workflow, using the target values
          # ...

      - name: Locate update set XML
        env:
          FOLDER: ${{ inputs.update_set_folder }}
        run: |
          XML=$(find "servicenow/update-sets/$FOLDER" -name '*.xml' | head -n 1)
          test -n "$XML" || { echo "No update set XML found in $FOLDER"; exit 1; }
          echo "Found: $XML"

